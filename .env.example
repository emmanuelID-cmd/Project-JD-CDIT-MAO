# Local synthetic prototype only. Do not put credentials or customer data here.
CDIT_DATABASE_PATH=data/cdit_support.db
# Synthetic Triage model target. A local .env may set ANTHROPIC_API_KEY.
# Never commit credentials. API calls are billable and require explicit run authorization.
CDIT_TRIAGE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Shawn's Lane agents (optional; defaults shown). Synthetic files only.
CDIT_KNOWLEDGE_DIR=synthetic_data/knowledge
CDIT_TROUBLESHOOTING_POLICY=synthetic_data/policy/troubleshooting-policy_v0.1.1.json
